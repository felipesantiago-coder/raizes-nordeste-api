# Porta onde a API escuta
PORT=3000

# Conexão do banco (SQLite — arquivo local, sem servidor)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (troque por um valor forte e longo)
JWT_SECRET="troque-por-um-segredo-forte"

# Tempo de expiração do token (ex.: 8h = jornada de trabalho)
JWT_EXPIRA_EM="8h"
