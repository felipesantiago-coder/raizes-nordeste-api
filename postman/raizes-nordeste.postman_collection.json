            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"atendente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: atendente autenticado', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('atendenteToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup — login cliente sem consentimento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente2@raizes.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            {
              "listen": "test",
