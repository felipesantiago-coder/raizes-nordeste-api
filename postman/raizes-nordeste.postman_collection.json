    {
      "name": "Fidelidade",
      "item": [
        {
          "name": "T19 — Saldo de pontos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/fidelidade/saldo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T19: saldo com consentimento (350 seed + 4 do T14)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const corpo = pm.response.json();",
                  "  pm.expect(corpo.consentimentoFidelidade).to.eql(true);",
                  "  pm.expect(corpo.saldoPontos).to.eql(354);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "T20 — Resgate válido de 100 pontos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fidelidade/resgates",
            "body": { "mode": "raw", "raw": "{\n  \"pontos\": 100\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T20: resgate 201 com cupom de R$ 10', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const corpo = pm.response.json();",
                  "  pm.expect(corpo.pontosResgatados).to.eql(100);",
                  "  pm.expect(corpo.cupomDesconto).to.eql('R$ 10.00');",
                  "  pm.expect(corpo.saldoPontos).to.eql(254);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "T21 — Resgate sem consentimento (negativo, 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cliente2Token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/fidelidade/resgates",
            "body": { "mode": "raw", "raw": "{\n  \"pontos\": 100\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T21: FIDELIDADE_SEM_CONSENTIMENTO', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.eql('FIDELIDADE_SEM_CONSENTIMENTO');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auditoria",
