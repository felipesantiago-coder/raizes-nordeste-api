{
  "info": {
    "_postman_id": "b7e1c8d2-5a4e-4f1a-9c3d-raizesnordeste",
    "name": "Raízes do Nordeste — Plano de Testes (API)",
    "description": "Coleção de testes da API Raízes do Nordeste.\n\nCenários T01 a T24 (positivos e negativos) cobrindo autenticação/autorização, validações, regras de negócio do fluxo crítico (pedido → pagamento mock → status), fidelidade com consentimento, estoque e auditoria.\n\n**Ordem sugerida:** executar a coleção inteira em ordem (a pasta 'Setup' popula os tokens usados pelas demais). Requisito prévio: API rodando em http://localhost:3000 com banco migrado e seed aplicado (`npx prisma migrate reset --force` recria tudo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "gerenteToken", "value": "" },
    { "key": "cozinhaToken", "value": "" },
    { "key": "atendenteToken", "value": "" },
    { "key": "cliente2Token", "value": "" },
    { "key": "emailCadastro", "value": "" },
    { "key": "pedidoId", "value": "" },
    { "key": "pedidoRecusadoId", "value": "" },
    { "key": "pagamentoId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup — logins por perfil",
      "item": [
        {
          "name": "T01 — Login válido (cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('T01: status 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test('T01: accessToken e perfil CLIENTE', () => {",
                  "  pm.expect(corpo.accessToken).to.be.a('string');",
                  "  pm.expect(corpo.user.perfil).to.eql('CLIENTE');",
                  "});",
                  "pm.collectionVariables.set('accessToken', corpo.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup — login gerente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"gerente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: gerente autenticado', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('gerenteToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup — login cozinha",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cozinha@raizes.com\",\n  \"senha\": \"Senha@123\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
